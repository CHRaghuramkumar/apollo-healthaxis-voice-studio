# Password for /admin. Required.
ADMIN_PASSWORD=choose-a-long-password

# ElevenLabs API key. Used only on the server to open live agent sessions.
# Never put this in the browser or in data/use-cases.json.
ELEVENLABS_API_KEY=

# Optional. Signs the admin session cookie. A random secret is used if this is empty.
SESSION_SECRET=

PORT=8000
